
[Unit]

Description=NInfer Qwen3.8-27B Server

After=network.target



[Service]

Type=simple

User=berni

WorkingDirectory=/opt/ninfer-v100

ExecStart=/opt/ninfer-v100/build-v100/apps/ninfer-serve /DATA/models/qwen3_8_27b.ninfer --host 127.0.0.1 --port 8082 --model-id qwen3.8-27b --max-context 131072 --max-concurrency 1 --kv-capacity auto --no-thinking --log-level info

Restart=on-failure

RestartSec=5



[Install]

WantedBy=multi-user.target

