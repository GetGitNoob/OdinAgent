# =========================================================
# ODIN AGENT - Konfiguration
# Kopieren als .env und Werte anpassen.
# .env NIE committen (steht in .gitignore).
# =========================================================

# ---- LLM (OpenAI-kompatible API, z.B. llama.cpp / Bonsai) ----
LLM_BASE_URL=http://127.0.0.1:11436/v1
LLM_MODEL=Ternary-Bonsai-2-27B-PQ2_0.gguf
LLM_API_KEY=local-dummy
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# ---- Agent ----
MAX_HISTORY_MESSAGES=20
SYSTEM_PROMPT=Du bist Odin, ein lokaler Assistent auf dem Server Odin. Antworte kurz und praezise auf Deutsch.

# ---- Filesystem-Tool: erlaubte Roots (kommagetrennt) ----
FILESYSTEM_ALLOWED_ROOTS=/opt/odin-agent,/tmp

# ---- Terminal-Tool ----
TERMINAL_TIMEOUT=10
TERMINAL_MAX_OUTPUT=10000

# ---- Server ----
# 8000 gehoert dem SearXNG/Docker-Container; der Agent nutzt 8081.
HOST=0.0.0.0
PORT=8081

# ---- WhatsApp (spaeter; z.zt. Adapter-Interface) ----
WHATSAPP_ENABLED=false
